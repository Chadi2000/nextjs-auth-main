generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}
//DATABASE_URL="mysql://johndoe:randompassword@localhost:3306/mydb"

